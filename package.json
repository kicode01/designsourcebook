{
  "name": "designsourcebook",
  "version": "1.0.0",
  "description": "Design Sourcebook — a provenance-tracked registry of 417 design systems, 36,641 tokens, 7,627 brand logos, CLI, MCP server, and 4-tool Design Studio",
  "type": "module",
  "homepage": "https://designsourcebook.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kicode01/designsourcebook.git"
  },
  "bugs": {
    "url": "https://github.com/kicode01/designsourcebook/issues"
  },
  "keywords": [
    "design-systems",
    "design-tokens",
    "dtcg",
    "mcp",
    "oklch",
    "tailwind",
    "shadcn",
    "webgl2",
    "logo-maker",
    "brand-guidelines"
  ],
  "bin": {
    "sourcebook": "./bin/sourcebook.mjs"
  },
  "scripts": {
    "import": "node scripts/import.mjs",
    "ingest": "node scripts/ingest-batch.mjs",
    "coverage": "node scripts/coverage.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "build": "node scripts/build-catalog.mjs",
    "build:standalone": "node scripts/build-catalog.mjs --standalone",
    "build:prod": "npm --prefix studio/app ci --no-audit --no-fund && npm --prefix studio/app run build && node scripts/build-catalog.mjs",
    "studio:dev": "npm --prefix studio/app run dev",
    "studio:build": "npm --prefix studio/app run build",
    "typecheck": "npm --prefix studio/app run typecheck",
    "verify": "node bin/sourcebook.mjs lint --all && npm --prefix studio/app run build && node scripts/build-catalog.mjs",
    "sync": "node scripts/sync-sources.mjs",
    "lint": "node bin/sourcebook.mjs lint --all",
    "mcp": "node bin/sourcebook.mjs mcp",
    "discover": "node scripts/discover-github.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:sync": "node scripts/db-seed.mjs --sync",
    "db:seed:logos": "node scripts/db-seed-logos.mjs"
  },
  "files": [
    "bin",
    "lib",
    "systems",
    "index.json"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "allo-font": "^1.0.0",
    "glisse": "^0.6.0"
  }
}
