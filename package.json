{
  "name": "designsourcebook",
  "version": "0.1.0",
  "description": "Design Sourcebook — a verified, installable registry of design systems for coding agents",
  "type": "module",
  "bin": {
    "sourcebook": "./bin/sourcebook.mjs"
  },
  "scripts": {
    "import": "node scripts/import.mjs",
    "ingest": "node scripts/ingest-batch.mjs",
    "coverage": "node scripts/coverage.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "build": "node scripts/build-catalog.mjs",
    "sync": "node scripts/sync-sources.mjs",
    "lint": "node bin/sourcebook.mjs lint --all",
    "mcp": "node bin/sourcebook.mjs mcp",
    "discover": "node scripts/discover-github.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:sync": "node scripts/db-seed.mjs --sync",
    "db:seed:logos": "node scripts/db-seed-logos.mjs"
  },
  "files": [
    "bin",
    "lib",
    "systems",
    "index.json"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "allo-font": "^1.0.0"
  }
}
