# Design Sourcebook — Environment Configuration Template
# Copy this file to .env.local for local database & API integrations.

# Neon Serverless Postgres connection string (powers /api/catalog, /api/systems, /api/logos, /api/icon-packs)
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Optional GitHub Personal Access Token for higher rate limits during GitHub discovery & popularity sync
GITHUB_TOKEN=""

# Optional Vercel Cron secret for protecting /api/sync-popularity
CRON_SECRET=""
