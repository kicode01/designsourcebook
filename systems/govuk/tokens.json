{
  "color": {
    "brand-colour": {
      "$value": "#1d70b8",
      "$type": "color"
    },
    "text-colour": {
      "$value": "#0b0c0c",
      "$type": "color"
    },
    "inverse-text-colour": {
      "$value": "#fff",
      "$type": "color"
    },
    "template-background-colour": {
      "$value": "#f4f8fb",
      "$type": "color"
    },
    "body-background-colour": {
      "$value": "#fff",
      "$type": "color"
    },
    "print-text-colour": {
      "$value": "#000",
      "$type": "color"
    },
    "secondary-text-colour": {
      "$value": "#484949",
      "$type": "color"
    },
    "focus-colour": {
      "$value": "#fd0",
      "$type": "color"
    },
    "focus-text-colour": {
      "$value": "#0b0c0c",
      "$type": "color"
    },
    "error-colour": {
      "$value": "#ca3535",
      "$type": "color"
    },
    "success-colour": {
      "$value": "#0f7a52",
      "$type": "color"
    },
    "border-colour": {
      "$value": "#cecece",
      "$type": "color"
    },
    "input-border-colour": {
      "$value": "#0b0c0c",
      "$type": "color"
    },
    "hover-colour": {
      "$value": "#cecece",
      "$type": "color"
    },
    "link-colour": {
      "$value": "#1a65a6",
      "$type": "color"
    },
    "link-visited-colour": {
      "$value": "#54319f",
      "$type": "color"
    },
    "link-hover-colour": {
      "$value": "#0f385c",
      "$type": "color"
    },
    "link-active-colour": {
      "$value": "#0b0c0c",
      "$type": "color"
    },
    "surface-background-colour": {
      "$value": "#f4f8fb",
      "$type": "color"
    },
    "surface-text-colour": {
      "$value": "#0b0c0c",
      "$type": "color"
    },
    "primary": {
      "$value": "#1d70b8",
      "$type": "color"
    }
  },
  "typography": {
    "root-font-size": {
      "$value": {
        "fontSize": {
          "value": 16,
          "unit": "px !default"
        }
      },
      "$type": "typography"
    },
    "context-font-size": {
      "$value": {
        "fontSize": {
          "value": null,
          "unit": "$contextfontsize * px"
        }
      },
      "$type": "typography"
    }
  }
}
