{
  "color": {
    "primary-color": {
      "$value": "#1779ba",
      "$type": "color"
    },
    "secondary-color": {
      "$value": "#767676",
      "$type": "color"
    },
    "success-color": {
      "$value": "#3adb76",
      "$type": "color"
    },
    "warning-color": {
      "$value": "#ffae00",
      "$type": "color"
    },
    "alert-color": {
      "$value": "#cc4b37",
      "$type": "color"
    },
    "primary": {
      "$value": "#1779ba",
      "$type": "color"
    },
    "secondary": {
      "$value": "#767676",
      "$type": "color"
    },
    "success": {
      "$value": "#3adb76",
      "$type": "color"
    },
    "warning": {
      "$value": "#ffae00",
      "$type": "color"
    },
    "alert": {
      "$value": "#cc4b37",
      "$type": "color"
    },
    "light-gray": {
      "$value": "#e6e6e6",
      "$type": "color"
    },
    "medium-gray": {
      "$value": "#cacaca",
      "$type": "color"
    },
    "dark-gray": {
      "$value": "#8a8a8a",
      "$type": "color"
    },
    "black": {
      "$value": "#0a0a0a",
      "$type": "color"
    },
    "white": {
      "$value": "#fefefe",
      "$type": "color"
    }
  },
  "typography": {
    "badge-font-size": {
      "$value": {
        "fontSize": {
          "value": 0.6,
          "unit": "rem"
        }
      },
      "$type": "typography"
    },
    "dropdown-font-size": {
      "$value": {
        "fontSize": {
          "value": 1,
          "unit": "rem"
        }
      },
      "$type": "typography"
    },
    "label-font-size": {
      "$value": {
        "fontSize": {
          "value": 0.8,
          "unit": "rem"
        }
      },
      "$type": "typography"
    },
    "font-size": {
      "$value": {
        "fontSize": {
          "value": null,
          "unit": "\"rem,"
        }
      },
      "$type": "typography"
    },
    "stat-font-size": {
      "$value": {
        "fontSize": {
          "value": 2.5,
          "unit": "rem !default"
        }
      },
      "$type": "typography"
    },
    "font-size-temp": {
      "$value": {
        "fontSize": {
          "value": 1,
          "unit": "rem"
        }
      },
      "$type": "typography"
    }
  }
}
