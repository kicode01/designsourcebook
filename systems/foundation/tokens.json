{
  "color": {
    "primary-color": {
      "$value": "#1779ba",
      "$type": "color"
    },
    "secondary-color": {
      "$value": "#767676",
      "$type": "color"
    },
    "success-color": {
      "$value": "#3adb76",
      "$type": "color"
    },
    "warning-color": {
      "$value": "#ffae00",
      "$type": "color"
    },
    "alert-color": {
      "$value": "#cc4b37",
      "$type": "color"
    },
    "light-gray": {
      "$value": "#e6e6e6",
      "$type": "color"
    },
    "medium-gray": {
      "$value": "#cacaca",
      "$type": "color"
    },
    "dark-gray": {
      "$value": "#8a8a8a",
      "$type": "color"
    },
    "black": {
      "$value": "#0a0a0a",
      "$type": "color"
    },
    "white": {
      "$value": "#fefefe",
      "$type": "color"
    },
    "primary": {
      "$value": "#1779ba",
      "$type": "color"
    },
    "secondary": {
      "$value": "#767676",
      "$type": "color"
    },
    "success": {
      "$value": "#3adb76",
      "$type": "color"
    },
    "warning": {
      "$value": "#ffae00",
      "$type": "color"
    },
    "alert": {
      "$value": "#cc4b37",
      "$type": "color"
    }
  },
  "typography": {
    "global-font-size": {
      "$value": {
        "fontSize": {
          "value": 100,
          "unit": "%"
        }
      },
      "$type": "typography"
    },
    "body-font-family": {
      "$value": {
        "fontFamily": [
          "\"Helvetica Neue\", Helvetica, Roboto, Arial, sans-serif"
        ]
      },
      "$type": "typography"
    },
    "h1": {
      "$value": {
        "fontSize": {
          "value": 2,
          "unit": "em"
        }
      },
      "$type": "typography"
    },
    "html": {
      "$value": {
        "fontSize": {
          "value": 100,
          "unit": "%"
        }
      },
      "$type": "typography"
    },
    "body": {
      "$value": {
        "fontFamily": [
          "\"Helvetica Neue\", Helvetica, Roboto, Arial, sans-serif"
        ],
        "lineHeight": 1.5
      },
      "$type": "typography"
    },
    "lead": {
      "$value": {
        "fontSize": {
          "value": 125,
          "unit": "%"
        },
        "lineHeight": 1.6
      },
      "$type": "typography"
    },
    "accordion-title": {
      "$value": {
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "lineHeight": 1
      },
      "$type": "typography"
    },
    "badge-font-size": {
      "$value": {
        "fontSize": {
          "value": 0.6,
          "unit": "rem"
        }
      },
      "$type": "typography"
    },
    "dropdown-font-size": {
      "$value": {
        "fontSize": {
          "value": 1,
          "unit": "rem"
        }
      },
      "$type": "typography"
    },
    "label-font-size": {
      "$value": {
        "fontSize": {
          "value": 0.8,
          "unit": "rem"
        }
      },
      "$type": "typography"
    },
    "font-family-monospace": {
      "$value": {
        "fontFamily": [
          "Consolas, \"Liberation Mono\", Courier, monospace"
        ]
      },
      "$type": "typography"
    },
    "small-font-size": {
      "$value": {
        "fontSize": {
          "value": 80,
          "unit": "%"
        }
      },
      "$type": "typography"
    },
    "stat-font-size": {
      "$value": {
        "fontSize": {
          "value": 2.5,
          "unit": "rem"
        }
      },
      "$type": "typography"
    },
    "font-size-temp": {
      "$value": {
        "fontSize": {
          "value": 1,
          "unit": "rem"
        }
      },
      "$type": "typography"
    }
  },
  "radius": {
    "card": {
      "$value": {
        "value": 0,
        "unit": "px"
      },
      "$type": "dimension"
    },
    "badge": {
      "$value": {
        "value": 50,
        "unit": "%"
      },
      "$type": "dimension"
    },
    "button": {
      "$value": {
        "value": 0,
        "unit": "px"
      },
      "$type": "dimension"
    },
    "nav": {
      "$value": {
        "value": 4,
        "unit": "px"
      },
      "$type": "dimension"
    },
    "default": {
      "$value": {
        "value": 0,
        "unit": "px"
      },
      "$type": "dimension"
    }
  }
}
