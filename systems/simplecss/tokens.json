{
  "color": {
    "bg": {
      "$value": "#fff",
      "$type": "color"
    },
    "accent-bg": {
      "$value": "#f5f7ff",
      "$type": "color"
    },
    "text": {
      "$value": "#212121",
      "$type": "color"
    },
    "text-light": {
      "$value": "#585858",
      "$type": "color"
    },
    "border": {
      "$value": "#d8dae1",
      "$type": "color"
    },
    "accent": {
      "$value": "#0d47a1",
      "$type": "color"
    },
    "accent-light": {
      "$value": "#90caf9",
      "$type": "color"
    },
    "code": {
      "$value": "#d81b60",
      "$type": "color"
    },
    "preformatted": {
      "$value": "#444",
      "$type": "color"
    },
    "marked": {
      "$value": "#ffdd33",
      "$type": "color"
    },
    "disabled": {
      "$value": "#efefef",
      "$type": "color"
    },
    "accent-hover": {
      "$value": "#1266e2",
      "$type": "color"
    },
    "primary": {
      "$value": "#0d47a1",
      "$type": "color"
    }
