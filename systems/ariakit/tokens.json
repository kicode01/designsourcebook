      "$value": "#edf0f3",
      "$type": "color"
    },
    "link-bg": {
      "$value": "#007acc",
      "$type": "color"
    },
    "link-text": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "link-text-1": {
      "$value": "#006bb3",
