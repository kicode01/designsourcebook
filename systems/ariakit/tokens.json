      "$type": "color"
    },
    "shadow": {
      "$value": "rgba(0,0,0,.1)",
      "$type": "color"
    },
    "stroke-color": {
      "$value": "#e3e3e3",
      "$type": "color"
    },
    "bg-canvas": {
      "$value": "#fcfdfd",
